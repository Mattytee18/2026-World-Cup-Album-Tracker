{
  "name": "panini-tracker",
  "version": "1.0.0",
  "description": "Panini FIFA World Cup 2026 Sticker Tracker",
  "author": "Mattytee18",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.panini.tracker",
    "productName": "Panini WC2026 Tracker",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "32.0.0",
    "electron-builder": "24.13.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
